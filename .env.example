# Database Configuration
DATABASE_PATH=agent.db

# AWS Bedrock Configuration
# 
# For LOCAL development: Configure AWS credentials using 'aws configure'
# For EC2 deployment: Attach an IAM Role to your EC2 instance (DO NOT use hardcoded credentials)
#
# Required IAM Permissions:
# {
#   "Version": "2012-10-17",
#   "Statement": [{
#     "Effect": "Allow",
#     "Action": ["bedrock:InvokeModel"],
#     "Resource": [
#       "arn:aws:bedrock:us-east-1::foundation-model/meta.llama3-8b-instruct-v1:0",
#       "arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v1"
#     ]
#   }]
# }
#
# IMPORTANT: Enable access to both the selected chat model and
# Amazon Titan Text Embeddings V1 in the AWS Bedrock console:
# https://console.aws.amazon.com/bedrock/ -> Model access -> Manage model access
AWS_REGION=us-east-1

# Common Bedrock Model IDs:
# - meta.llama3-8b-instruct-v1:0 (Recommended for cost-efficiency)
# - meta.llama3-70b-instruct-v1:0 (Better quality, higher cost)
# - anthropic.claude-3-haiku-20240307-v1:0 (Alternative option)
BEDROCK_MODEL_ID=meta.llama3-8b-instruct-v1:0

# Admin Password for Database Reset
# Required by docker-compose. Generate a long, unique value.
ADMIN_PASSWORD=

# Disable automatic deletion by default. Set an explicit policy only if required.
MESSAGE_RETENTION_DAYS=0

# Same-origin deployments do not need CORS. For separate trusted frontends,
# provide a comma-separated allowlist such as https://app.example.com.
CORS_ALLOW_ORIGINS=

# Comma-separated HTTP Host allowlist used in production.
ALLOWED_HOSTS=healthdataagent.com,www.healthdataagent.com,localhost,127.0.0.1,app
